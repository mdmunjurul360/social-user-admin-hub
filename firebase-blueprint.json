{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user roles and public profile info",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Post": {
      "title": "Post",
      "description": "Content posts from admin",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "video"] },
        "videoUrl": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "type", "authorId"]
    },
    "Comment": {
      "title": "Comment",
      "description": "User comments on posts",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "userId", "content"]
    },
    "Like": {
      "title": "Like",
      "description": "Post likes",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["postId", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and roles"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Public content posts"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Comments nested under posts"
    },
    "/posts/{postId}/likes/{likeId}": {
      "schema": "Like",
      "description": "Likes nested under posts"
    }
  }
}
